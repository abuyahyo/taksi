# Сервер
PORT=5000

# (Ихтиёрий) Frontend манзили — CORS учун. Backend frontend'ни ўзи берса
# (same-origin, одатдаги ҳолат) КЕРАК ЭМАС. Frontend алоҳида хостда бўлсагина
# керак: вергул билан бир нечтаси, масалан: https://sizniki.ngrok-free.app
# FRONTEND_URL=https://sizniki.ngrok-free.app

# PostgreSQL база
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taxi_app
DB_USER=postgres
DB_PASSWORD=parolingiz

# (Ихтиёрий) SSL CA серти йўли — берилса DATABASE_URL уланишида серверни
# тўлиқ текширади (MITM ҳимояси). Supabase CA'ни кабинетдан юклаб олинг.
# DB_SSL_CA=/path/to/supabase-ca.crt

# JWT махфий калит (ўзгартиринг!)
JWT_SECRET=juda_maxfiy_kalit_ozgartiring
JWT_EXPIRES=7d

# Telegram Mini App — бот токени (@BotFather'дан олинади).
# Бўш қолдирилса /api/auth/telegram ўчиқ туради (илова веб'да ишлайверади).
TELEGRAM_BOT_TOKEN=

# Telegram webhook (локация → Mini App тугмаси). setWebhook'нинг secret_token'и
# сифатида ишлатилади — фақат Telegram сўров юбора олсин.
TELEGRAM_WEBHOOK_SECRET=
# Mini App'нинг очиқ HTTPS URL'и (BotFather Web App домени билан бир хил бўлсин).
MINIAPP_URL=https://overwrite-pursuant-junkie.ngrok-free.dev

# Манзил қидируви мамлакат чекови (Nominatim). Дефолт 'uz' (Тошкент фокуси).
# Бўш қолдиринг ёки '*' қилинг → бутун дунё. Кўп мамлакат: 'uz,kz,ru'.
GEOCODE_COUNTRIES=uz

# Payme мерчант (реал калитлар Payme кабинетидан олинади)
PAYME_ID=test_payme_id
PAYME_KEY=test_payme_key

# Click мерчант (реал калитлар Click кабинетидан олинади)
CLICK_SERVICE_ID=test_service_id
CLICK_MERCHANT_ID=test_merchant_id
CLICK_SECRET=test_secret

# Тўлов тест режими — реал merchant калитларсиз синаш учун.
# 1 = /payment/test-pay ёқилади ва дефолт калитли webhook'лар ўтказилади.
# ПРОДАКШНДА БЎШ/0 қолдиринг — акс ҳолда тўлов сохталаштирилиши мумкин.
PAYMENT_TEST_MODE=0

# Web Push (VAPID) — браузер ёпиқ бўлса ҳам билдиришнома учун.
# Калитларни яратиш:  npx web-push generate-vapid-keys
# (бўш қолдирилса push жим ўчиқ туради, илова ишлайверади)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@safar.taksi
