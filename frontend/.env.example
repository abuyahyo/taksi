# Backend API манзили
# Локал учун: VITE_API_URL=http://localhost:5000
# Render деплойда: ўз backend service URL'ингизни ёзинг (масалан https://tez-taxi-api.onrender.com)
VITE_API_URL=http://localhost:5000

# Google Sign-In — Google Cloud Console'дан OAuth Client ID (бепул, карта керак эмас).
# Backend'даги GOOGLE_CLIENT_ID билан бир хил қиймат. Бўш → Google тугмаси кўрсатилмайди.
VITE_GOOGLE_CLIENT_ID=
